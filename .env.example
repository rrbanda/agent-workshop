# ACME Agent Workshop - Environment Configuration
# Copy this file to .env and update values as you progress through the modules.
#
# ┌──────────────────────────────────────────────────────────────────────┐
# │  QUICK START                                                        │
# │                                                                     │
# │  1. cp .env.example .env                                            │
# │  2. Set LLAMA_STACK_BASE_URL (Module 00 -- provided to you)        │
# │  3. Set API URLs after deploying backend APIs (Module 01)           │
# │  4. Set MCP URLs after deploying MCP servers (Module 02)            │
# │  5. Set Mortgage URLs when you reach the capstone                   │
# │                                                                     │
# │  All services run on OpenShift. Use the route URLs from             │
# │  'oc get route' commands shown in each module's README.             │
# └──────────────────────────────────────────────────────────────────────┘

# =============================================================================
# Llama Stack Server (pre-deployed on RHOAI) -- SET THIS FIRST (Module 00)
# =============================================================================
# Get the URL with: oc get route llamastack -o jsonpath='https://{.spec.host}'
LLAMA_STACK_BASE_URL=https://llamastack-<namespace>.apps.<cluster>

LLAMA_STACK_API_KEY=fake
INFERENCE_MODEL=vllm-inference/gpt-oss-120b

# =============================================================================
# ACME Backend APIs -- SET AFTER MODULE 01
# =============================================================================
# Get these URLs after deploying the APIs in Module 01:
#   echo "https://$(oc get route acme-customer-service -o jsonpath='{.spec.host}')"
#   echo "https://$(oc get route acme-finance-service -o jsonpath='{.spec.host}')"
CUSTOMER_API_BASE_URL=https://acme-customer-service-<namespace>.apps.<cluster>
FINANCE_API_BASE_URL=https://acme-finance-service-<namespace>.apps.<cluster>

# =============================================================================
# MCP Servers -- SET AFTER MODULE 02
# =============================================================================
# Get these URLs after deploying MCP servers in Module 02:
#   echo "https://$(oc get route mcp-customer-route -o jsonpath='{.spec.host}')/mcp"
#   echo "https://$(oc get route mcp-finance-route -o jsonpath='{.spec.host}')/mcp"
CUSTOMER_MCP_SERVER_URL=https://mcp-customer-route-<namespace>.apps.<cluster>/mcp
FINANCE_MCP_SERVER_URL=https://mcp-finance-route-<namespace>.apps.<cluster>/mcp

# =============================================================================
# Mortgage Use Case -- SET WHEN YOU REACH THE CAPSTONE
# =============================================================================
# Get these URLs after deploying the Mortgage API in the capstone:
#   echo "https://$(oc get route mortgage-api-route -o jsonpath='{.spec.host}')"
MORTGAGE_API_BASE_URL=https://mortgage-api-route-<namespace>.apps.<cluster>
MORTGAGE_MCP_SERVER_URL=https://mcp-mortgage-route-<namespace>.apps.<cluster>/mcp

# =============================================================================
# RAG (Module 08)
# =============================================================================
EMBEDDING_MODEL=vllm-embedding/nomic-embed-text-v1-5
EMBEDDING_DIMENSION=768

# =============================================================================
# Safety Shields (Module 09)
# =============================================================================
# Uses TrustyAI Guardrails Orchestrator with built-in regex PII detectors.
# The shield is registered at runtime via 4_register_shield.py.
SHIELD_PROVIDER=trustyai_fms
SHIELD_ID=pii_detector

# =============================================================================
# Evaluations (Module 10)
# =============================================================================
JUDGE_MODEL=vllm-inference/gpt-oss-120b
CANDIDATE_MODEL=vllm-inference/gpt-oss-120b
LLAMA_STACK_BENCHMARK_PROVIDER_ID=meta-reference
