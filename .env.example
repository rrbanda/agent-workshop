# NovaCrest Agent Workshop - Environment Configuration
# Copy this file to .env and update LLAMA_STACK_BASE_URL to your server.
#
# All models are served by the Llama Stack server. Set the base URL to your
# Llama Stack endpoint and the model variables to models registered on it.

# =============================================================================
# Llama Stack Server
# =============================================================================
LLAMA_STACK_BASE_URL=http://localhost:8321
LLAMA_STACK_API_KEY=fake
INFERENCE_MODEL=vllm-inference/gpt-oss-120b
# INFERENCE_MODEL=gemini/models/gemini-2.5-flash  # alternative

# =============================================================================
# NovaCrest Backend APIs
# =============================================================================
CUSTOMER_API_BASE_URL=http://localhost:8081
FINANCE_API_BASE_URL=http://localhost:8082

# --- Remote (OpenShift routes) ---
# CUSTOMER_API_BASE_URL=https://customer-api-route-your-namespace.apps.example.com
# FINANCE_API_BASE_URL=https://finance-api-route-your-namespace.apps.example.com

# =============================================================================
# MCP Servers
# =============================================================================
CUSTOMER_MCP_SERVER_URL=http://localhost:9001/mcp
FINANCE_MCP_SERVER_URL=http://localhost:9002/mcp
PORT_FOR_CUSTOMER_MCP=9001
HOST_FOR_CUSTOMER_MCP=0.0.0.0
PORT_FOR_FINANCE_MCP=9002
HOST_FOR_FINANCE_MCP=0.0.0.0

# --- Remote (OpenShift routes) ---
# IMPORTANT: MCP server URLs must be reachable FROM the Llama Stack server,
# not just from your local machine. When Llama Stack is remote, MCP servers
# must also be deployed remotely (or exposed via a public URL).
# CUSTOMER_MCP_SERVER_URL=https://mcp-customer-route-your-namespace.apps.example.com/mcp
# FINANCE_MCP_SERVER_URL=https://mcp-finance-route-your-namespace.apps.example.com/mcp

# =============================================================================
# Mortgage Use Case (Capstone)
# =============================================================================
MORTGAGE_API_BASE_URL=http://localhost:8083
MORTGAGE_MCP_SERVER_URL=http://localhost:9003/mcp
PORT_FOR_MORTGAGE_MCP=9003
HOST_FOR_MORTGAGE_MCP=0.0.0.0

# --- Remote (OpenShift routes) ---
# MORTGAGE_API_BASE_URL=https://mortgage-api-route-your-namespace.apps.example.com
# MORTGAGE_MCP_SERVER_URL=https://mcp-mortgage-route-your-namespace.apps.example.com/mcp

# =============================================================================
# RAG (Module 08)
# =============================================================================
EMBEDDING_MODEL=sentence-transformers/nomic-ai/nomic-embed-text-v1.5
EMBEDDING_DIMENSION=768

# =============================================================================
# Safety Shields (Module 09)
# =============================================================================
SHIELD_PROVIDER=llama-guard
SHIELD_ID=content_safety
# The llama-guard provider works with any instruction-following model.
# Set SHIELD_MODEL to any capable LLM on your Llama Stack server.
SHIELD_MODEL=vllm-inference/gpt-oss-120b

# =============================================================================
# Evaluations (Module 10)
# =============================================================================
JUDGE_MODEL=vllm-inference/gpt-oss-120b
CANDIDATE_MODEL=vllm-inference/gpt-oss-120b
LLAMA_STACK_BENCHMARK_PROVIDER_ID=localfs

