# ACME Agent Workshop - Environment Configuration
# Copy this file to .env and update values for your deployment scenario.
#
# ┌──────────────────────────────────────────────────────────────────────┐
# │  QUICK START                                                        │
# │                                                                     │
# │  1. cp .env.example .env                                            │
# │  2. Choose your deployment:                                         │
# │     • Instructor-led: Paste the URLs your instructor provides       │
# │     • OpenShift (self-deploy): Run 00-setup/admin/deploy.sh, then  │
# │       paste the URLs it prints at the end                           │
# │     • Local: Use the localhost defaults as-is                       │
# │  3. All remote URLs must be reachable from the Llama Stack server   │
# │                                                                     │
# │  IMPORTANT: If Llama Stack is remote, MCP servers MUST also be     │
# │  remote. localhost MCP + remote Llama Stack does NOT work.          │
# └──────────────────────────────────────────────────────────────────────┘

# =============================================================================
# Llama Stack Server
# =============================================================================
# Local:
LLAMA_STACK_BASE_URL=http://localhost:8321
# Remote (OpenShift route -- get with: oc get route llamastack -o jsonpath='https://{.spec.host}'):
# LLAMA_STACK_BASE_URL=https://llamastack-<namespace>.apps.<cluster>

LLAMA_STACK_API_KEY=fake
INFERENCE_MODEL=vllm-inference/gpt-oss-120b

# =============================================================================
# ACME Backend APIs (Module 01)
# =============================================================================
# Local:
CUSTOMER_API_BASE_URL=http://localhost:8081
FINANCE_API_BASE_URL=http://localhost:8082
# Remote (OpenShift routes -- deployed by 00-setup/admin/deploy.sh or your instructor):
# CUSTOMER_API_BASE_URL=https://acme-customer-service-<namespace>.apps.<cluster>
# FINANCE_API_BASE_URL=https://acme-finance-service-<namespace>.apps.<cluster>

# =============================================================================
# MCP Servers (Module 02)
# =============================================================================
# Local (only works when Llama Stack is also local):
CUSTOMER_MCP_SERVER_URL=http://localhost:9001/mcp
FINANCE_MCP_SERVER_URL=http://localhost:9002/mcp
# Remote (OpenShift routes -- REQUIRED when Llama Stack is remote):
# CUSTOMER_MCP_SERVER_URL=https://mcp-customer-route-<namespace>.apps.<cluster>/mcp
# FINANCE_MCP_SERVER_URL=https://mcp-finance-route-<namespace>.apps.<cluster>/mcp

# =============================================================================
# Mortgage Use Case - Capstone
# =============================================================================
# Local:
MORTGAGE_API_BASE_URL=http://localhost:8083
MORTGAGE_MCP_SERVER_URL=http://localhost:9003/mcp
# Remote (OpenShift routes):
# MORTGAGE_API_BASE_URL=https://mortgage-api-route-<namespace>.apps.<cluster>
# MORTGAGE_MCP_SERVER_URL=https://mcp-mortgage-route-<namespace>.apps.<cluster>/mcp

# =============================================================================
# Local MCP Server Ports (only needed when running MCP servers locally)
# =============================================================================
# PORT_FOR_CUSTOMER_MCP=9001
# HOST_FOR_CUSTOMER_MCP=0.0.0.0
# PORT_FOR_FINANCE_MCP=9002
# HOST_FOR_FINANCE_MCP=0.0.0.0
# PORT_FOR_MORTGAGE_MCP=9003
# HOST_FOR_MORTGAGE_MCP=0.0.0.0

# =============================================================================
# RAG (Module 08)
# =============================================================================
EMBEDDING_MODEL=vllm-embedding/nomic-embed-text-v1-5
EMBEDDING_DIMENSION=768

# =============================================================================
# Safety Shields (Module 09)
# =============================================================================
# Uses TrustyAI Guardrails Orchestrator with built-in regex PII detectors.
# The shield is registered at runtime via 4_register_shield.py.
SHIELD_PROVIDER=trustyai_fms
SHIELD_ID=pii_detector

# =============================================================================
# Evaluations (Module 10)
# =============================================================================
JUDGE_MODEL=vllm-inference/gpt-oss-120b
CANDIDATE_MODEL=vllm-inference/gpt-oss-120b
LLAMA_STACK_BENCHMARK_PROVIDER_ID=meta-reference
